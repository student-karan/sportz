// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Match {
  id          Int        @id @default(autoincrement())
  homeTeam    String
  awayTeam    String
  sport       String
  startTime   DateTime
  status      MatchStatus   @default(SCHEDULED)

  homeScore   Int           @default(0)
  awayScore   Int           @default(0)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  commentary  Commentary[]

  @@index([status])
  @@index([sport])
  @@index([startTime])
}

model Commentary {
  id           String    @id @default(cuid())

  // FK relation
  matchId      Int
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Who performed the action
  actor        String

  // What happened
  message      String

  // Match minute / timestamp
  minute       Int

  // Handles ordering of events
  sequenceNo   Int

  // Flexible event-specific data
  details      Json

  createdAt    DateTime  @default(now())

  @@index([matchId])
  @@index([matchId, sequenceNo])
  @@index([createdAt])
}