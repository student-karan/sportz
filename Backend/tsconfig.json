{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "types": ["node"]
  },
  "include": ["src/**/*", "*.ts"],
  "exclude": ["dist","node_modules"]
}